# AXIVON LEARN - Git Ignore Policy
# Organization: Axivon Technologies

# Dependencies
node_modules/
.pnp
.pnp.js

# Build and Production Artifacts
dist/
dist-ssr/
build/
out/
.next/
*.tsbuildinfo

# Environment and Secret Files (Strictly prohibited from git)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Logs and Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
logs/

# Testing and Coverage
coverage/
*.lcov
.nyc_output/
reports/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE and Editor Directories
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary / Scratch Files
tmp/
temp/
scratch/
*.bak
*.orig

# Cache
.eslintcache
.stylelintcache
.turbo/
.cache/
