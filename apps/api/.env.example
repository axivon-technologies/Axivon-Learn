# ==============================================================================
# AXIVON LEARN — Backend API Environment Template (apps/api/.env.example)
# Copy to repository root `.env` (or `apps/api/.env`) for local development.
# NEVER commit real `.env` files, database credentials, or production secrets!
# ==============================================================================

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/axivon_learn

# Authentication & Session Secrets (Replace with 32+ char random secrets in staging/prod)
JWT_SECRET=replace_with_32_plus_char_random_jwt_secret_key
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=replace_with_32_plus_char_random_refresh_secret
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_16_plus_char_cookie_secret

# Optional Seed Account Overrides (Used by `npm run seed --workspace=apps/api`)
SEED_ADMIN_EMAIL=admin@axivon.local
SEED_ADMIN_PASSWORD=replace_with_local_seed_admin_password
SEED_LEARNER_EMAIL=learner@axivon.local
SEED_LEARNER_PASSWORD=replace_with_local_seed_learner_password
