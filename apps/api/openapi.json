{
  "openapi": "3.0.3",
  "info": {
    "title": "AXIVON LEARN REST API",
    "version": "1.0.0",
    "description": "Production-ready modular REST API for the AXIVON LEARN EdTech platform (Auth, Users, Catalog, Learning Paths, Projects, Enrollments, Lessons, Progress, Server-Scored Quizzes, and Admin CMS)."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Versioned REST API prefix"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Health check and OpenAPI contract discovery"
    },
    {
      "name": "Auth",
      "description": "Registration, login, session refresh, logout, and password reset"
    },
    {
      "name": "Users",
      "description": "Authenticated user profile and horizontal ownership guards"
    },
    {
      "name": "Categories",
      "description": "Public active curriculum categories"
    },
    {
      "name": "Courses",
      "description": "Published course catalog filtering, pagination, and syllabus"
    },
    {
      "name": "Modules",
      "description": "Ordered course modules"
    },
    {
      "name": "Lessons",
      "description": "Lesson detail, free-preview vs enrollment locking, and embed rights"
    },
    {
      "name": "LearningPaths",
      "description": "Published multi-course learning roadmaps"
    },
    {
      "name": "Projects",
      "description": "Published hands-on project briefs"
    },
    {
      "name": "Enrollments",
      "description": "Idempotent learner course enrollments"
    },
    {
      "name": "Progress",
      "description": "Authoritative lesson completion and synced course percentages"
    },
    {
      "name": "Quizzes",
      "description": "Answer-key-safe quiz retrieval and server-computed attempt grading"
    },
    {
      "name": "Admin",
      "description": "Admin-only CMS authoring and platform metrics (strict RBAC)"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "axivon_access_token"
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "data": {
            "type": "object",
            "nullable": true,
            "example": null
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "statusCode"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "INVALID_ID",
                  "INVALID_JSON",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "CONFLICT",
                  "DUPLICATE_RESOURCE",
                  "ATTEMPT_LIMIT_REACHED",
                  "RATE_LIMITED",
                  "SERVICE_UNAVAILABLE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "statusCode": {
                "type": "integer"
              },
              "details": {
                "nullable": true
              }
            }
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "example": 1
          },
          "limit": {
            "type": "integer",
            "example": 12
          },
          "total": {
            "type": "integer",
            "example": 2
          },
          "totalPages": {
            "type": "integer",
            "example": 1
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "API and database health status",
        "responses": {
          "200": {
            "description": "Service health payload"
          }
