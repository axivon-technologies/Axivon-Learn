# ==============================================================================
# AXIVON LEARN - Environment Configuration Template
# Organization: Axivon Technologies
#
# IMPORTANT SECURITY NOTICE:
# 1. NEVER commit actual credentials, secret keys, or passwords to Git.
# 2. Copy this file to '.env' in your local environment for development.
# 3. All values below are placeholder descriptions only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API SERVER CONFIGURATION (apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# Baseline: MongoDB + Mongoose (as per project blueprint)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/axivon_learn

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# Session or JWT secret keys (use high-entropy randomly generated strings in actual .env)
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_placeholder
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_minimum_32_characters_placeholder
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_encryption_secret_placeholder

# ------------------------------------------------------------------------------
# 4. INITIAL SEED / ADMIN BOOTSTRAP (For local development initialization only)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@axivon.local
INITIAL_ADMIN_PASSWORD=change_me_in_secure_vault_placeholder

# ------------------------------------------------------------------------------
# 5. FRONTEND CLIENT CONFIGURATION (apps/web)
# Vite exposes variables prefixed with VITE_ to client-side code
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=Axivon Learn
VITE_APP_TAGLINE="Learn. Build. Grow."
